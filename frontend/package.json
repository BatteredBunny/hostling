{
  "name": "hostling-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm generate:api && astro build",
    "lint": "oxlint src --ignore-pattern \"src/generated/**\" && eslint src && astro check",
    "lint:fix": "oxlint --fix src --ignore-pattern \"src/generated/**\" && eslint --fix src",
    "format": "oxfmt --write 'src/**/*.{ts,tsx,css,astro}' '*.mjs' eslint.config.js .oxfmtrc.json",
    "format:check": "oxfmt --check 'src/**/*.{ts,tsx,css,astro}' '*.mjs' eslint.config.js .oxfmtrc.json",
    "generate:api": "openapi-ts",
    "check": "astro check",
    "dev:demo": "HOSTLING_DEMO=1 astro dev",
    "build:demo": "HOSTLING_DEMO=1 astro build",
    "preview:demo": "HOSTLING_DEMO=1 astro preview --host 127.0.0.1 --port 4321",
    "screenshots": "pnpm build:demo && playwright test"
  },
  "dependencies": {
    "@astrojs/solid-js": "^7.1.2",
    "astro": "^7.4.5",
    "lucide-solid": "^1.67.0",
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/compiler-rs": "^0.5.2",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.65.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-oxlint": "^1.90.0",
    "eslint-plugin-solid": "^0.18.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
}
