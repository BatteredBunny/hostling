<!DOCTYPE html>
<html lang="en">

<head>
    {{ template "header.gohtml" . }}
    <link rel="stylesheet" href="/public/styles/common.css">
    <link rel="stylesheet" href="/public/styles/login.css">
    {{ template "meta-title.gohtml" "Login" }}
</head>

<body>
    {{ template "toolbar.gohtml" . }}

    <main>
        <div class="container">
            <h1>Login</h1>

            <div id="login-page">
                <setting-group class="login-panel">
                    <div class="setting-group-header"><h2>Welcome back</h2></div>
                    <div class="setting-group-body">
                        {{ if .NoProvidersConfigured }}
                        <div class="warning-modal">
                            <p><strong>Server configuration error:</strong> No authentication providers are configured. Please contact the server administrator to set up {{ .Branding }} correctly.</p>
                        </div>
                        {{ else }}
                        <p class="login-description">Choose a linked account to log in.</p>
                        <div class="login-providers">
                            {{ range .Providers }}
                            <a class="social-login" href="/api/auth/login/{{ .Name }}">
                                <svg class="lucide-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <use href="/public/assets/lucide-sprite.svg#{{ .Icon }}" />
                                </svg>
                                <span>Log in with {{ if eq .Name "github" }}GitHub{{ else if eq .Name "openid-connect" }}OpenID Connect{{ else }}{{ .Name }}{{ end }}</span>
                            </a>
                            {{ end }}
                        </div>
                        {{ end }}
                        <p class="login-register">Have an invitation code? <a href="/register">Create an account</a></p>
                    </div>
                </setting-group>
            </div>
        </div>
    </main>
</body>

</html>
