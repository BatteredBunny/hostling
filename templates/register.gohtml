<!DOCTYPE html>
<html lang="en">

<head>
    {{ template "header.gohtml" . }}
    <link rel="stylesheet" href="/public/styles/common.css">
    <link rel="stylesheet" href="/public/styles/register.css">
    {{ template "meta-title.gohtml" "Register" }}
</head>

<body>
    {{ template "toolbar.gohtml" . }}

    <main>
        <div class="container">
            <h1>Register</h1>

            <div id="registration-page">
                <setting-group class="registration-panel">
                    <div class="setting-group-header"><h2>Create your account</h2></div>
                    <div class="setting-group-body">
                        <p class="registration-description">Enter your invitation code to join {{ .Branding }}.</p>
                        <form action="/api/auth/register" method="POST" class="registration-form">
                            <div class="hostling-input-field">
                                <label for="invitation-code">Invitation code</label>
                                <input class="hostling-input" id="invitation-code" name="code" type="text"
                                    placeholder="Enter your invitation code" required autocomplete="off"
                                    autocapitalize="none" spellcheck="false">
                            </div>
                            <button type="submit" class="registration-submit">
                                <svg class="lucide-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <use href="/public/assets/lucide-sprite.svg#user-plus" />
                                </svg>
                                Create account
                            </button>
                        </form>
                        <p class="registration-login">Already have an account? <a href="/login">Log in</a></p>
                    </div>
                </setting-group>
            </div>
        </div>
    </main>

</body>

</html>